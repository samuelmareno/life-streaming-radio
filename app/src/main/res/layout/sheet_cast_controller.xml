<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom sheet tombol Cast saat sedang casting: volume dan berhenti (CastControllerSheetFragment). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <include layout="@layout/view_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="4dp">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_tv" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:fontFamily="@font/archivo"
                android:maxLines="2"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                tools:targetApi="p"
                tools:text="TV Ruang Tamu" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/cast_sheet_secondary_text"
                android:textSize="14sp"
                tools:text="@string/cast_sheet_playing_here" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/volume_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_volume_up" />

        <com.google.android.material.slider.Slider
            android:id="@+id/volume_slider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:contentDescription="@string/cast_sheet_volume"
            android:stepSize="1"
            android:valueFrom="0"
            android:valueTo="20"
            app:haloColor="@color/cast_sheet_halo"
            app:labelBehavior="gone"
            app:thumbColor="@color/colorPrimary"
            app:trackColorActive="@color/colorPrimary"
            app:trackColorInactive="@color/cast_sheet_outline" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/stop_button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/cast_sheet_stop"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:backgroundTint="@color/colorPrimary"
        app:cornerRadius="28dp" />

</LinearLayout>
